// Dual-engine Rune script: runs LSM and logstor tables concurrently.
//
// Each engine has its own keyspace/table, prepared statements, and
// engine-suffixed public functions, giving distinct HDR histogram tags:
//   fn--lsm_write, fn--lsm_read   (LSM default storage engine)
//   fn--logstor_write, fn--logstor_read  (logstor storage engine)
//
// Create schema (creates BOTH tables in one call):
// $ latte schema /path/to/latte_cs_alike_dual_engine.rn %IP% \
//     -P replication_factor=2 \
//     -P lsm_keyspace=\"ks_lsm\" \
//     -P lsm_table=\"t_lsm\" \
//     -P logstor_keyspace=\"ks_logstor\" \
//     -P logstor_table=\"t_logstor\" \
//     -P column_count=10 -P column_size=200 -P key_size=48 \
//     -P speculative_retry=\"NONE\" \
//     -P min_per_shard_tablet_count=64
//
// Populate LSM table (500M rows):
// $ latte run -f lsm_write --consistency ALL --duration 500000000 \
//     --threads 32 --concurrency 32 --rate 250000 \
//     --start-cycle 1 --end-cycle 500000000 \
//     -P lsm_row_count=500000000 -P lsm_offset=0 \
//     -P column_count=10 -P column_size=200 -P key_size=48 \
//     /path/to/latte_cs_alike_dual_engine.rn %IP%
//
// Populate logstor table (500M rows):
// $ latte run -f logstor_write --consistency ALL --duration 500000000 \
//     --threads 32 --concurrency 32 --rate 250000 \
//     --start-cycle 1 --end-cycle 500000000 \
//     -P logstor_row_count=500000000 -P logstor_offset=0 \
//     -P column_count=10 -P column_size=200 -P key_size=48 \
//     /path/to/latte_cs_alike_dual_engine.rn %IP%
//
// Measured mixed step (write:30 read:70, logstor at 60% ops, lsm at 40% ops):
// Two concurrent latte run invocations on separate loaders or in parallel:
//   latte run -f logstor_write --rate 108000 -d $duration ...
//   latte run -f logstor_read  --rate 252000 -d $duration ...
//   latte run -f lsm_write     --rate 72000  -d $duration ...
//   latte run -f lsm_read      --rate 168000 -d $duration ...

use latte::*;

// ─── Shared schema parameters ───────────────────────────────────────────────
const REPLICATION_FACTOR = latte::param!("replication_factor", 2);
const COMPRESSION = latte::param!("compression", "");
const COMPACTION_STRATEGY = latte::param!("compaction_strategy", "");
const SPECULATIVE_RETRY = latte::param!("speculative_retry", "");
const MIN_PER_SHARD_TABLET_COUNT = latte::param!("min_per_shard_tablet_count", 0);

// ─── Shared row-shape parameters ────────────────────────────────────────────
pub const KEY_SIZE = latte::param!("key_size", 48);
pub const COLUMN_SIZE = latte::param!("column_size", 200);
pub const COLUMN_COUNT = latte::param!("column_count", 10);

// ─── LSM keyspace / table / row-range parameters ────────────────────────────
pub const LSM_KEYSPACE = latte::param!("lsm_keyspace", "ks_lsm");
pub const LSM_TABLE = latte::param!("lsm_table", "t_lsm");
pub const LSM_ROW_COUNT = latte::param!("lsm_row_count", 500_000_000);
pub const LSM_OFFSET = latte::param!("lsm_offset", 0);

// ─── Logstor keyspace / table / row-range parameters ────────────────────────
pub const LOGSTOR_KEYSPACE = latte::param!("logstor_keyspace", "ks_logstor");
pub const LOGSTOR_TABLE = latte::param!("logstor_table", "t_logstor");
pub const LSM_GAUSS_MEAN = latte::param!("lsm_gauss_mean", 0);
pub const LSM_GAUSS_STDDEV = latte::param!("lsm_gauss_stddev", 0);
pub const LOGSTOR_ROW_COUNT = latte::param!("logstor_row_count", 500_000_000);
pub const LOGSTOR_OFFSET = latte::param!("logstor_offset", 0);
pub const LOGSTOR_GAUSS_MEAN = latte::param!("logstor_gauss_mean", 0);
pub const LOGSTOR_GAUSS_STDDEV = latte::param!("logstor_gauss_stddev", 0);

// ─── Key access distribution ─────────────────────────────────────────────────
// "sequential" (default) walks keys in cycle order (i % ROW_COUNT + OFFSET).
// "random" scatters keys uniformly via hash_range. "gauss" uses Gaussian hotspot
// controlled by per-engine gauss params.
// Populate commands (prepare_write_cmd) omit -P distribution to get the default
// sequential fill; measured step commands pass -P distribution="\"random\"" explicitly.
const DISTRIBUTION = latte::param!("distribution", "sequential");

// ─── Prepared statement name constants ──────────────────────────────────────
// Distinct names per engine so both can be prepared in the same session.
const P_STMT_LSM_WRITE = "latte_prep_stmt__lsm_write";
const P_STMT_LSM_READ = "latte_prep_stmt__lsm_read";
const P_STMT_LOGSTOR_WRITE = "latte_prep_stmt__logstor_write";
const P_STMT_LOGSTOR_READ = "latte_prep_stmt__logstor_read";

//////////////////////////////
// SCHEMA & PREPARE          //
//////////////////////////////

/// Create both keyspaces and tables in one schema call.
/// LSM table uses default storage engine; logstor table sets storage_engine='logstor'.
pub async fn schema(db) {
    if COLUMN_COUNT < 1 {
        return Err("'column_count' cannot be less than '1'")
    }

    // Build shared table DDL fragments
    let columns_def = "";
    for i in 0..=COLUMN_COUNT-1 {
        columns_def += ", \"C" + `${i}` + "\" blob";
    }
    let compression = ") WITH compression = {";
    if COMPRESSION.is_empty() {
        compression += "}";
    } else {
        compression += " 'sstable_compression' : '" + COMPRESSION + "' }"
    }
    let compaction = "";
    if !COMPACTION_STRATEGY.is_empty() {
        compaction += " AND COMPACTION = { 'class' : '" + COMPACTION_STRATEGY + "' }"
    }
    let speculative_retry = "";
    if !SPECULATIVE_RETRY.is_empty() {
        speculative_retry += " AND speculative_retry = '" + SPECULATIVE_RETRY + "' "
    }
    let tablets = "";
    if MIN_PER_SHARD_TABLET_COUNT > 0 {
        tablets += ` AND tablets = {'min_per_shard_tablet_count': '${MIN_PER_SHARD_TABLET_COUNT}'}`
    }
    let comment = " AND comment='Created by latte dual-engine'";

    // ── LSM keyspace + table (no storage_engine clause → default LSM) ────────
    db.execute(`CREATE KEYSPACE IF NOT EXISTS ${LSM_KEYSPACE}
        WITH REPLICATION = { 'class': 'NetworkTopologyStrategy', 'replication_factor': ${REPLICATION_FACTOR} }
        AND durable_writes = true
    `).await?;
    db.execute(
        `CREATE TABLE IF NOT EXISTS ${LSM_KEYSPACE}.${LSM_TABLE}` +
        `(key blob PRIMARY KEY${columns_def}${compression}${compaction}${speculative_retry}${tablets}${comment}`
    ).await?;

    // ── Logstor keyspace + table (storage_engine = 'logstor') ───────────────
    db.execute(`CREATE KEYSPACE IF NOT EXISTS ${LOGSTOR_KEYSPACE}
        WITH REPLICATION = { 'class': 'NetworkTopologyStrategy', 'replication_factor': ${REPLICATION_FACTOR} }
        AND durable_writes = true
    `).await?;
    db.execute(
        `CREATE TABLE IF NOT EXISTS ${LOGSTOR_KEYSPACE}.${LOGSTOR_TABLE}` +
        `(key blob PRIMARY KEY${columns_def}${compression}${compaction}${speculative_retry}` +
        ` AND storage_engine = 'logstor'${tablets}${comment}`
    ).await?;
}

pub async fn erase(db) {
    db.execute(`TRUNCATE TABLE ${LSM_KEYSPACE}.${LSM_TABLE}`).await?;
    db.execute(`TRUNCATE TABLE ${LOGSTOR_KEYSPACE}.${LOGSTOR_TABLE}`).await?;
}

pub async fn prepare(db) {
    if COLUMN_COUNT < 1 {
        return Err("'column_count' cannot be less than '1'")
    }
    println!("debug: LSM keyspace: {ks}", ks=LSM_KEYSPACE);
    println!("debug: Logstor keyspace: {ks}", ks=LOGSTOR_KEYSPACE);

    let columns_keys = "";
    let columns_values = "";
    for i in 0..=COLUMN_COUNT-1 {
        columns_keys += ", \"C" + `${i}` + "\"";
        columns_values += `, :C${i}`;
    }

    // LSM prepared statements
    db.prepare(
        P_STMT_LSM_WRITE,
        `INSERT INTO ${LSM_KEYSPACE}.${LSM_TABLE}(key${columns_keys}) VALUES (:key${columns_values})`
    ).await?;
    db.prepare(P_STMT_LSM_READ, `SELECT * FROM ${LSM_KEYSPACE}.${LSM_TABLE} WHERE key = :key`).await?;

    // Logstor prepared statements
    db.prepare(
        P_STMT_LOGSTOR_WRITE,
        `INSERT INTO ${LOGSTOR_KEYSPACE}.${LOGSTOR_TABLE}(key${columns_keys}) VALUES (:key${columns_values})`
    ).await?;
    db.prepare(P_STMT_LOGSTOR_READ, `SELECT * FROM ${LOGSTOR_KEYSPACE}.${LOGSTOR_TABLE} WHERE key = :key`).await?;

    // Gauss distribution state for both engines
    prepare_gauss_distribution_lsm(db).await;
    prepare_gauss_distribution_logstor(db).await
}

///////////////////////
// UTILITY FUNCTIONS //
///////////////////////

async fn prepare_gauss_distribution_lsm(db) {
    if LSM_GAUSS_MEAN > 0 && LSM_GAUSS_STDDEV > 0 {
        db.data.lsm_gauss_mean = LSM_GAUSS_MEAN as f64;
        db.data.lsm_gauss_stddev = LSM_GAUSS_STDDEV as f64;
        db.data.lsm_gauss_enabled = true;
        println!("debug: LSM gauss enabled: mean={mean}, stddev={stddev}",
            mean=db.data.lsm_gauss_mean, stddev=db.data.lsm_gauss_stddev);
    } else {
        db.data.lsm_gauss_enabled = false;
    }
}

async fn prepare_gauss_distribution_logstor(db) {
    if LOGSTOR_GAUSS_MEAN > 0 && LOGSTOR_GAUSS_STDDEV > 0 {
        db.data.logstor_gauss_mean = LOGSTOR_GAUSS_MEAN as f64;
        db.data.logstor_gauss_stddev = LOGSTOR_GAUSS_STDDEV as f64;
        db.data.logstor_gauss_enabled = true;
        println!("debug: Logstor gauss enabled: mean={mean}, stddev={stddev}",
            mean=db.data.logstor_gauss_mean, stddev=db.data.logstor_gauss_stddev);
    } else {
        db.data.logstor_gauss_enabled = false;
    }
}

async fn get_lsm_partition_idx(db, i) {
    if db.data.lsm_gauss_enabled {
        let current_idx = normal(i, db.data.lsm_gauss_mean, db.data.lsm_gauss_stddev) as i64;
        if current_idx >= LSM_OFFSET + LSM_ROW_COUNT {
            current_idx = LSM_OFFSET + LSM_ROW_COUNT - 1;
        } else if current_idx < LSM_OFFSET {
            current_idx = LSM_OFFSET;
        }
        return current_idx;
    } else if DISTRIBUTION == "random" {
        return LSM_OFFSET + hash_range(i, LSM_ROW_COUNT);
    } else {
        return i % LSM_ROW_COUNT + LSM_OFFSET;
    }
}

async fn get_logstor_partition_idx(db, i) {
    if db.data.logstor_gauss_enabled {
        let current_idx = normal(i, db.data.logstor_gauss_mean, db.data.logstor_gauss_stddev) as i64;
        if current_idx >= LOGSTOR_OFFSET + LOGSTOR_ROW_COUNT {
            current_idx = LOGSTOR_OFFSET + LOGSTOR_ROW_COUNT - 1;
        } else if current_idx < LOGSTOR_OFFSET {
            current_idx = LOGSTOR_OFFSET;
        }
        return current_idx;
    } else if DISTRIBUTION == "random" {
        return LOGSTOR_OFFSET + hash_range(i, LOGSTOR_ROW_COUNT);
    } else {
        return i % LOGSTOR_ROW_COUNT + LOGSTOR_OFFSET;
    }
}

pub async fn get_blob_columns_data(key, idx) {
    let columns = [key];
    for current_column_idx in 0..=COLUMN_COUNT-1 {
        columns.push(blob(idx + current_column_idx * LSM_ROW_COUNT, COLUMN_SIZE));
    }
    return columns
}

///////////////////////////////////////////
// USER-FACING FUNCTIONS (engine-suffixed) //
///////////////////////////////////////////
// HDR tags produced: fn--lsm_write, fn--lsm_read, fn--logstor_write, fn--logstor_read
// get_latte_operation_type() matches "_write"/"_read" suffixes, so these are
// classified as write/read operations respectively.

pub async fn lsm_write(db, i) {
    let partition_idx = get_lsm_partition_idx(db, i).await;
    let key = blob(partition_idx, KEY_SIZE);
    db.execute_prepared(P_STMT_LSM_WRITE, get_blob_columns_data(key, partition_idx).await).await?
}

pub async fn lsm_read(db, i) {
    let partition_idx = get_lsm_partition_idx(db, i).await;
    let key = blob(partition_idx, KEY_SIZE);
    db.execute_prepared(P_STMT_LSM_READ, [key]).await?
}

pub async fn logstor_write(db, i) {
    let partition_idx = get_logstor_partition_idx(db, i).await;
    let key = blob(partition_idx, KEY_SIZE);
    db.execute_prepared(P_STMT_LOGSTOR_WRITE, get_blob_columns_data(key, partition_idx).await).await?
}

pub async fn logstor_read(db, i) {
    let partition_idx = get_logstor_partition_idx(db, i).await;
    let key = blob(partition_idx, KEY_SIZE);
    db.execute_prepared(P_STMT_LOGSTOR_READ, [key]).await?
}
