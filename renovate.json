{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "commitBodyTable": true,
  "constraints": {
    "uv": "0.13.0"
  },
  "recreateWhen": "always",
  "ignorePresets": [
    "group:monorepos",
    "group:recommended"
  ],
  "schedule": [
    "every weekend"
  ],
  "assignees": [
    "scylladb/qa-maintainers"
  ],
  "reviewers": [
    "scylladb/qa-maintainers"
  ],
  "labels": [
    "backport/none",
    "renovate",
    "dependencies"
  ],
  "enabledManagers": [
    "pep621",
    "github-actions",
    "helm-values",
    "custom.regex"
  ],
  "customDatasources": {
    "scylla-doctor": {
      "defaultRegistryUrlTemplate": "https://s3.amazonaws.com/downloads.scylladb.com?prefix=downloads/scylla-doctor/tar/&delimiter=/",
      "format": "plain",
      "transformTemplates": [
        "{ \"releases\": $match($join(releases.version, \"\\n\"), /scylla-doctor-([0-9.]+)\\.tar\\.gz/).{ \"version\": groups[0] } }"
      ]
    }
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track scylla-doctor versions from downloads.scylladb.com",
      "managerFilePatterns": [
        "/^defaults/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "scylla_doctor_version:\\s*[\"'](?<currentValue>[\\d.]+)[\"']"
      ],
      "depNameTemplate": "scylla-doctor",
      "datasourceTemplate": "custom.scylla-doctor",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Keep the generated scylla-doctor config docs in step with defaults/test_default.yaml",
      "managerFilePatterns": [
        "/^docs/configuration_options/scylla-doctor\\.md$/"
      ],
      "matchStrings": [
        "## \\*\\*scylla_doctor_version\\*\\*[\\s\\S]*?\\*\\*default:\\*\\* (?<currentValue>[\\d.]+)"
      ],
      "depNameTemplate": "scylla-doctor",
      "datasourceTemplate": "custom.scylla-doctor",
      "versioningTemplate": "semver-coerced"
    },
    {
      "customType": "regex",
      "description": "Keep every uv pin on one version: Renovate's own lock runs, the hydra image, the image build job and the devcontainer",
      "managerFilePatterns": [
        "/^renovate\\.json$/",
        "/^Dockerfile$/",
        "/^\\.github/workflows/build-docker-image\\.yaml$/",
        "/^\\.devcontainer/setup\\.sh$/"
      ],
      "matchStrings": [
        "\"uv\":\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "ghcr\\.io/astral-sh/uv:(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "pip install uv==(?<currentValue>\\d+\\.\\d+\\.\\d+)",
        "astral\\.sh/uv/(?<currentValue>\\d+\\.\\d+\\.\\d+)/install\\.sh"
      ],
      "depNameTemplate": "uv",
      "datasourceTemplate": "pypi"
    }
  ],
  "packageRules": [
    {
      "groupName": "All pip dependencies",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "!scylla-driver"
      ],
      "enabled": true,
      "addLabels": [
        "New Hydra Version"
      ]
    },
    {
      "groupName": "all non-major dependencies",
      "groupSlug": "all-minor-patch",
      "matchPackageNames": [
        "*"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchManagers": [
        "pep621"
      ],
      "enabled": false,
      "addLabels": [
        "New Hydra Version"
      ]
    },
    {
      "matchPackageNames": [
        "scylla-driver"
      ],
      "matchManagers": [
        "pep621"
      ],
      "enabled": true,
      "addLabels": [
        "New Hydra Version"
      ]
    },
    {
      "description": "Run the artifacts tests, which run scylla-doctor, on scylla-doctor bumps",
      "matchPackageNames": [
        "scylla-doctor"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "enabled": true,
      "addLabels": [
        "scylla-doctor",
        "test-artifacts"
      ]
    },
    {
      "groupName": null,
      "matchManagers": [
        "helm-values"
      ],
      "enabled": true,
      "addLabels": [
        "test-integration"
      ]
    },
    {
      "description": "Run the minicloud artifacts provision tests on minicloud image bumps",
      "matchManagers": [
        "helm-values"
      ],
      "matchPackageNames": [
        "ghcr.io/scylladb/minicloud"
      ],
      "addLabels": [
        "test-provision-minicloud-aws",
        "test-provision-minicloud-gce"
      ]
    },
    {
      "description": "Open PRs for Docker Hub image updates immediately as they appear",
      "matchDatasources": [
        "docker"
      ],
      "schedule": [
        "at any time"
      ],
      "enabled": true
    },
    {
      "description": "uv bumps change the hydra image, and the image build re-locks uv.lock with the new uv",
      "matchManagers": [
        "custom.regex"
      ],
      "matchPackageNames": [
        "uv"
      ],
      "enabled": true,
      "addLabels": [
        "New Hydra Version"
      ]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "osvVulnerabilityAlerts": true,
  "github-actions": {
    "enabled": true
  },
  "helm-values": {
    "managerFilePatterns": [
      "/(^|/)values_.*\\.ya?ml$/"
    ]
  },
  "pip-compile": {
    "managerFilePatterns": [
      "/(^|/)requirements\\.txt$/"
    ]
  }
}
