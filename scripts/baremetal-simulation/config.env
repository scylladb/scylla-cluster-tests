# Shared settings for the SCT-901 bare-metal simulation on AWS.
#
# Every value can be overridden from the environment:
#   SIM_INSTANCE_TYPE=i4i.xlarge scripts/baremetal-simulation/01_launch_hosts.py
#
# Shell scripts source this file; the Python scripts parse it through common.py.
# In both cases an already-exported variable wins over the value below.

# --- where -------------------------------------------------------------------
SIM_REGION=eu-west-1
SIM_AZ=eu-west-1a

# SCT infrastructure that already exists in every prepared region.  Looked up by
# tag, not hardcoded by id -- run `hydra prepare-regions -c aws -r <region>` if a
# lookup comes back empty.  See sdcm/utils/aws_region.py.
SIM_VPC_NAME=SCT-2-vpc
SIM_SCT_SG_NAME=SCT-2-sg
SIM_KEYPAIR=scylla_test_id_ed25519
SIM_SSH_KEY=~/.ssh/scylla_test_id_ed25519

# --- the "physical" hosts ----------------------------------------------------
# i4i.large has a real, unpartitioned local NVMe disk, which is what makes
# detect_disks() + scylla_setup behave the way they do on a physical host.
# A pure-EBS instance type would not.
SIM_INSTANCE_TYPE=i4i.large
SIM_LOADER_INSTANCE_TYPE=c6i.2xlarge
SIM_MONITOR_INSTANCE_TYPE=t3.large
SIM_ROOT_DISK_GB=40

# Phase A (artifact test): 1 / 0 / 0.  Phase B (perf smoke): 3 / 1 / 1.
SIM_DB_COUNT=1
SIM_LOADER_COUNT=0
SIM_MONITOR_COUNT=0

# Fedora cloud image defaults.  Leave SIM_AMI_ID empty to resolve the latest
# stable Fedora Cloud AMI at launch time (Rawhide/ELN/Prerelease are skipped).
SIM_AMI_ID=
SIM_AMI_OWNER=125523088429
SIM_AMI_NAME_PATTERN=Fedora-Cloud-Base-AmazonEC2.x86_64-*
# Oldest Fedora release the simulation accepts (keeps the resolver off ancient images).
SIM_MIN_FEDORA_VERSION=40
SIM_SSH_USER=fedora

# --- bookkeeping -------------------------------------------------------------
SIM_TEST_TAG=sct901-baremetal-sim
SIM_KEEP_HOURS=8
SIM_RUN_BY_USER=julia.yakovlev

# --- SCT wiring --------------------------------------------------------------
# get_baremetal_config() reads ./<name>.json from the repo root before S3.
SIM_BAREMETAL_CONFIG_NAME=baremetal_sct901
SIM_TEST_CASE=test-cases/artifacts/baremetal-fedora.yaml
SIM_SCYLLA_REPO=https://downloads.scylladb.com/rpm/centos/scylla-2025.3.repo
# Set SIM_UNIFIED_PACKAGE to a relocatable tarball URL to use the offline install
# path instead of the RPM repo (fallback 1 in the runbook).  When it is set,
# 04_render_test_case.py drops scylla_repo from the generated test case.
SIM_UNIFIED_PACKAGE=
SIM_PERF_TEST_CASE=test-cases/performance/perf-regression-throughput-baremetal-5gb.yaml
