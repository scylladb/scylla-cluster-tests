#!groovy

// trick from https://github.com/jenkinsci/workflow-cps-global-lib-plugin/pull/43
def lib = library identifier: 'sct@snapshot', retriever: legacySCM(scm)

managerPipeline(
    backend: 'aws',
    region: 'us-east-1',
    scylla_version: 'master:latest',
    billing_project: 'Single-copy backup',
    test_name: 'scylla_api_backup_restore_tests.ScyllaApiBackupRestoreTests.test_restore',
    // entry of defaults/manager_restore_benchmark_snapshots.yaml logged by test_backup
    mgmt_reuse_backup_snapshot_name: '',
    test_config: '''["test-cases/manager/scylla_api_restore.yaml", "configurations/object_storage_s3.yaml"]''',
)
