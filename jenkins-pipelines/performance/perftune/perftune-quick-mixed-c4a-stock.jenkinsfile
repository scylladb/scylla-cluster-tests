    backend: "gce",
    gce_datacenter: "us-east4",
    availability_zone: "a",
    provision_type: 'on_demand',
    gce_project: 'gcp-sct-project-1',
    test_name: "performance_regression_gradual_grow_throughput.PerformanceRegressionPredefinedStepsTest",
    test_config: '''["test-cases/performance/perf-regression-predefined-throughput-steps-1-node.yaml", "configurations/performance/perftune-quick-mixed.yaml", "configurations/tablets_disabled.yaml", "configurations/gce/c4a-highmem-16-lssd.yaml", "configurations/c-s-driver-version-4.yaml", "configurations/disable_kms.yaml"]''',
    sub_tests: ["test_mixed_gradual_increase_load"],
)
