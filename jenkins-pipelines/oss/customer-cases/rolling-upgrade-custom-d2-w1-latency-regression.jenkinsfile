#!groovy

// trick from https://github.com/jenkinsci/workflow-cps-global-lib-plugin/pull/43
def lib = library identifier: 'sct@snapshot', retriever: legacySCM(scm)

// NOTE: multiple real regions must be in alphabetical order for the 'custom_d2/workload1' case
rollingUpgradePipeline(
    backend: 'aws',
    region: '''["eu-central-1", "eu-north-1", "eu-west-1", "eu-west-2", "us-east-1"]''',
    base_versions: '',
    test_name: 'upgrade_test.UpgradeTest.test_cluster_upgrade_latency_regression',
    test_config: '''["test-cases/upgrades/rolling-upgrade-latency-regression-aws-custom-d2-workload1-5dcs.yaml", "configurations/tablets_disabled.yaml", "configurations/auth_cassandra.yaml"]''',
)
