#!groovy

// trick from https://github.com/jenkinsci/workflow-cps-global-lib-plugin/pull/43
def lib = library identifier: 'sct@snapshot', retriever: legacySCM(scm)

/** jobDescription
    Strong Consistency sanity longevity - the longevity-100gb-4h workload run against a strongly
    consistent keyspace on tablets, driven by cql-stress-cassandra-stress with the Raft-leader-aware
    load balancing policy, under SisyphusMonkey nemesis.

    Manual job: not wired into any trigger, run it from Jenkins with "Build with Parameters".

    Fragment order matters. Dict options such as append_scylla_yaml are merged key by key, but
    string options such as append_scylla_args are replaced by the last fragment that sets them, so
    enable_experimental_sc.yaml has to come after the test-case.
*/
longevityPipeline(
    backend: 'aws',
    region: 'eu-west-1',
    availability_zone: 'c',
    test_name: 'longevity_test.LongevityTest.test_custom_time',
    test_config: '''["test-cases/longevity/longevity-100gb-4h-cql-stress-sc.yaml", "configurations/strong_consistency/enable_experimental_sc.yaml", "configurations/strong_consistency/enable_commitlog_sync_batch.yaml", "configurations/stress_images/cql-stress-strong-consistency-leader-awarness.yaml"]''',
    instance_provision_fallback_on_demand: true
)
