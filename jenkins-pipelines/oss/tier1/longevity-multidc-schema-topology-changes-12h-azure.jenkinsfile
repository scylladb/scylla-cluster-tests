#!groovy

// trick from https://github.com/jenkinsci/workflow-cps-global-lib-plugin/pull/43
def lib = library identifier: 'sct@snapshot', retriever: legacySCM(scm)

longevityPipeline(
    backend: 'azure',
    availability_zone: 'a',
    azure_region_name: '''["eastus"]''',
    test_name: 'longevity_test.LongevityTest.test_custom_time',
    test_config: '''["test-cases/longevity/longevity-multidc-parallel-topology-schema-changes-12h.yaml", "configurations/azure/longevity-multidc-parallel-topology-schema-changes-12h.yaml", "configurations/network_config/all_addresses_ipv6_public.yaml", "configurations/azure/network_config/all_addresses_ipv6_public.yaml", "configurations/auth_cassandra.yaml"]''',

    timeout: [time: 820, unit: 'MINUTES']
)
