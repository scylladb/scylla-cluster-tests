#!groovy

// trick from https://github.com/jenkinsci/workflow-cps-global-lib-plugin/pull/43
def lib = library identifier: 'sct@snapshot', retriever: legacySCM(scm)

// SCT-1214: 1-DB-node throughput steps on i8g.4xlarge. Its steps live in configurations/performance/single-node/i8g.4xlarge.yaml.
perfRegressionParallelPipeline(
    backend: "aws",
    region: "us-east-1",
    test_name: "performance_regression_gradual_grow_throughput.PerformanceRegressionPredefinedStepsTest",
    test_config: '''["test-cases/performance/perf-regression-predefined-throughput-steps-1-node.yaml", "configurations/disable_kms.yaml", "configurations/disable_speculative_retry.yaml", "configurations/performance/single-node/i8g.4xlarge.yaml"]''',
    sub_tests: ["test_read_gradual_increase_load", "test_mixed_gradual_increase_load", "test_write_gradual_increase_load", "test_read_disk_only_gradual_increase_load"],
)
