# Perf weekly watcher settings. Copy to ~/perf-watcher/config.env (outside the repository) and edit.
# Never commit the filled-in copy: the dashboard share link grants access to anyone who has it.

# Your name, used in the prompt.
OWNER_NAME="Your Name"
# Your Slack member ID (Slack profile -> three dots -> Copy member ID). Capacity alerts and the
# Wednesday summary are sent to you as a direct message.
SLACK_USER_ID="U00000000"

# SCT checkout the watcher runs in; it must contain skills/perf-weekly-status-report.
SCT_DIR="$HOME/scylla-cluster-tests"
# Python with SCT dependencies, used to read Jenkins credentials from the KeyStore.
SCT_PYTHON="$SCT_DIR/.venv/bin/python"

# Where state, logs and scratch files go, and where the HTML reports are saved.
WATCHER_HOME="$HOME/perf-watcher"
REPORTS_DIR="$HOME/Downloads"

# Microbenchmark Trends dashboard (claude.ai artifact URL) you can edit; ask its owner for edit access.
# Leave empty to skip that report.
DASHBOARD_URL=""
# Link used in the email; a share link from the artifact's Share menu so recipients can open it.
DASHBOARD_SHARE_URL="$DASHBOARD_URL"

# Draft recipients (comma-separated) and signature. Ask the perf team for the weekly report list;
# it is not kept in the repository because the repository is public.
EMAIL_TO="name1@scylladb.com, name2@scylladb.com"
SIGNATURE="Your first name"
